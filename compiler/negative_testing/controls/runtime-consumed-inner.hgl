module conformance.negative_testing.runtime_consumed_inner

fn negative() -> i64 { yield -1us: 1 }
fn consume(tick: i64) { when { } }
fn drive_negative(tick: i64) -> i64 {
    consume(tick)
    negative()
}

test consumed_inner {
    assert raises("yield.negative_duration") {
        assert raises("yield.negative_duration") { eval(drive_negative, tick: [1, 1]) }
    }
}

module examples.unset_required_reads

struct Number {
    sibling: i64
    child: i64
}
struct Flag {
    sibling: i64
    child: bool
}
struct Samples {
    sibling: i64
    child: list<i64, 2>
}
struct Book {
    sibling: i64
    child: map<i64, i64>
}

fn read_number(value: Number) -> i64 {
    when {
        let copy = value
        return copy.child + 1
    }
}
fn read_flag(value: Flag) -> i64 {
    when {
        let copy = value
        if copy.child { return 1 } else { return 0 }
    }
}
fn read_length(value: Samples) -> i64 {
    when {
        let copy = value
        return len(copy.child)
    }
}
fn read_items(value: Book) -> i64 {
    when {
        let copy = value
        for key, child in items(copy.child) { return child }
        return 0
    }
}
fn retain_partial(value: tuple<i64, bool>) -> i64 {
    when {
        let copy = value
        let child = copy[1]
        let retained = (copy, child)
        return 7
    }
}

test unset_required_reads {
    assert raises("value.unset_read") {
        eval(read_number, value: [delta<Number>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(read_flag, value: [delta<Flag>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(read_length, value: [delta<Samples>(sibling: 1)])
    }
    assert raises("value.unset_read") {
        eval(read_items, value: [delta<Book>(sibling: 1)])
    }
    assert true
}

test present_payloads_and_retention {
    assert eval(read_number, value: [delta<Number>(sibling: 1, child: 0)]) == [1]
    assert eval(read_flag, value: [delta<Flag>(sibling: 1, child: false), delta<Flag>(child: true)]) == [0, 1]
    assert eval(read_length, value: [delta<Samples>(sibling: 1, child: delta<list<i64, 2>>(items: [0: 4, 1: 5]))]) == [2]
    assert eval(read_items, value: [delta<Book>(sibling: 1, child: delta<map<i64, i64>>(upsert: [7: 4]))]) == [4]
    assert eval(retain_partial, value: [(1, _)]) == [7]
}

# Reduction to an ordinary type does not erase an explicit delta requirement.
test scalar_lambda_result {
    # expect-error(type, "delta.type_mismatch")
    let callback = fn(value: i64) -> delta<i64> => false
}

test atomic_lambda_result {
    # expect-error(type, "delta.type_mismatch")
    let callback = fn(value: i64) -> delta<atomic<list<i64>>> => false
}

test rolling_lambda_result {
    # expect-error(type, "delta.type_mismatch")
    let callback = fn(value: i64) -> delta<rolling<i64, 2>> => false
}

test scalar_delta_replacement {
    var value: delta<i64> = 1
    # expect-error(type, "delta.type_mismatch")
    value = false
}

test atomic_delta_replacement {
    var value: delta<atomic<list<i64>>> = [1]
    # expect-error(type, "delta.type_mismatch")
    value = false
}

test rolling_delta_replacement {
    var value: delta<rolling<i64, 2>> = 1
    # expect-error(type, "delta.type_mismatch")
    value = false
}

test scalar_delta_field_replacement {
    var record: ScalarDeltaField = ScalarDeltaField(value: 1)
    # expect-error(type, "delta.type_mismatch")
    record.value = false
}

test atomic_delta_field_replacement {
    var record: AtomicDeltaField = AtomicDeltaField(value: [1])
    # expect-error(type, "delta.type_mismatch")
    record.value = false
}

test rolling_delta_field_replacement {
    var record: RollingDeltaField = RollingDeltaField(value: 1)
    # expect-error(type, "delta.type_mismatch")
    record.value = false
}

test generic_delta_field_replacement {
    var record: Publication<i64> = Publication<i64>(value: 1)
    # expect-error(type, "delta.type_mismatch")
    record.value = false
}

test unsupported_specialized_delta_shape {
    # Empty delta data is legal to store; using its type as a shape is not.
    let source: delta<map<i64, i64>> = delta<map<i64, i64>>()
    # expect-error(shape, "delta.unsupported_shape")
    let result = require_delta_shape(source)
}


    # expect-error(type, "delta.entry_constant")
    let value = delta<list<i64, 2>>(items: [position: 1])
}

# Positive controls: exact deltas, reduced values and stored removal data.
test admitted_delta_values {
    let scalar: delta<i64> = 1
    let mode: delta<Mode> = Mode::first
    let atomic: delta<atomic<Quote>> = Quote(bid: 2)
    let optional: delta<atomic<OptionalQuote>> = OptionalQuote(bid: 2)
    let recursive: delta<atomic<Chain>> = Chain(value: 3, next: Chain(value: 4))
    let family: delta<atomic<Event>> = Trade(label: "trade", price: 5)
    let arrival: delta<rolling<i64, 3, 1>> = 6
    assert scalar == 1
    assert mode == Mode::first
    assert atomic.bid == 2
    assert optional.bid == 2
    assert recursive.value == 3
    assert family.label == "trade"
    assert arrival == 6
    let fixed = delta<list<i64, 2>>(items: [0: 1])
    assert eval(forward_fixed, value: [fixed]) == [fixed]
    let quote = delta<Quote>(bid: 2)
    assert eval(forward_quote, value: [quote]) == [quote]
    var stored: list<delta<set<i64>>> = []
    push(stored, delta<set<i64>>(removed: [7]))
    assert len(stored) == 1
    # Formation alone need not know a growing endpoint's previous length.
    var tails: list<delta<list<i64>>> = []
    push(tails, delta<list<i64>>(items: [1: 9], remove: [1]))
    assert len(tails) == 1
}

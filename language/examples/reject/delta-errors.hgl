module examples.reject.delta_errors

struct Quote { bid: i64 }
struct OtherQuote { bid: i64 }
struct Box<T> { value: T }
struct Publication<T> { value: delta<T> }
struct ScalarDeltaField { value: delta<i64> }
struct AtomicDeltaField { value: delta<atomic<list<i64>>> }
struct RollingDeltaField { value: delta<rolling<i64, 2>> }
struct OptionalQuote {
    bid: i64
    ask: i64 = null
}
struct Chain {
    value: i64
    next: atomic<Chain> = null
}
abstract struct Event { label: str }
struct Trade: Event { price: i64 }
enum Mode { first = 1, second = 2 }
enum OtherMode { first = 1, second = 2 }

fn pass_through<T>(value: T) -> T {
    when { return delta_value(value) }
}
fn forward_fixed(value: list<i64, 2>) -> list<i64, 2> => pass_through(value)
fn forward_quote(value: Quote) -> Quote => pass_through(value)

const fn require_delta_shape<T>(value: T) -> i64 {
    let storage: list<delta<T>> = []
    return 0
}

# Each rejected test is an isolated source case; none of its statements runs.

# expect-error(shape, "delta.unsupported_shape")
const fn rejected_signal(value: delta<signal>) -> i64 => 0

# expect-error(shape, "delta.unsupported_shape")
const fn rejected_delta_as_shape(value: delta<delta<map<i64, i64>>>) -> i64 => 0

# expect-error(shape, "delta.unsupported_shape")
const fn rejected_atomic_delta_payload(value: delta<atomic<delta<map<i64, i64>>>>) -> i64 => 0

# expect-error(shape, "delta.unsupported_shape")
const fn rejected_collection_key(value: delta<map<list<i64>, i64>>) -> i64 => 0


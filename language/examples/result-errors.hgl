module examples.result_errors

const fn price(book: map<str, i64>, key: str) -> result<i64, error> {
    let item = get(book, key)
    if item == null {
        return err(error(code: "value.missing_key", message: "missing price"))
    }
    return ok(item)
}
const fn doubled(book: map<str, i64>, key: str) -> result<i64, error> {
    let item = price(book, key)?
    return ok(item * 2)
}
const fn recovered(book: map<str, i64>, key: str) -> i64 {
    let outcome = price(book, key)
    if is_err(outcome) { return 0 }
    return outcome.value
}
const fn diagnostic(outcome: result<i64, error>) -> str {
    if is_err(outcome) { return outcome.error.message }
    return "ok"
}
fn required(book: atomic<map<str, i64>>, key: str) -> i64 {
    when { return price(book, key)? }
}
fn outcome(book: atomic<map<str, i64>>, key: str) -> result<i64, error> {
    when { return price(book, key) }
}

test tagged_results_and_propagation {
    let full = map<str, i64>(items: ["X": 10])
    let empty = map<str, i64>(items: [])
    let success: result<i64, error> = ok(20)
    let failure: result<i64, error> =
        err(error(code: "value.missing_key", message: "missing price"))
    assert doubled(full, "X") == success
    assert doubled(empty, "X") == failure
    assert recovered(full, "X") == 10
    assert recovered(empty, "X") == 0
    assert diagnostic(failure) == "missing price"
    let uncoded = error(message: "domain failure")
    assert uncoded.code == null
    assert uncoded.context == null
    let code = error(code: "value.missing_key", message: "missing price").code
    if code != null { assert code == "value.missing_key" }
    let ten: result<i64, error> = ok(10)
    assert eval(outcome, book: [full, empty, empty, _], key: ["X"]) == [
        ten, failure, failure, _
    ]
    assert raises("value.missing_key") {
        eval(required, book: [empty], key: ["X"])
    }
}

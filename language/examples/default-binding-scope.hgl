module examples.default_binding_scope

const fn seed() -> i64 => 7
const fn choose(seed: i64, value: i64 = seed()) -> i64 => seed + value
fn configured(value: i64, const seed: i64, const fallback: i64 = seed()) -> i64 {
    when { return value + seed + fallback }
}
struct ScopePair {
    seed: i64 = 1
    value: i64 = seed()
}
struct Defaults<T> { items: list<T> = [] }

test {
    test defaults_use_defining_declarations_before_formal_or_field_bindings {
        # Defaults call the module seed; bodies still read their own parameters.
        assert choose(1) == 8
        assert choose(1, 3) == 4
        assert eval(const(choose), seed: [1, 2]) == [8, 9]
        assert eval(configured, value: [1, 2], seed: 99) == [107, 108]
        assert ScopePair(seed: 99).value == 7
        # Complete type substitution supplies the contextual empty-list type.
        assert len(Defaults<i64>().items) == 0
        assert len(Defaults<str>().items) == 0
    }
}

module examples.growing_list_publications

fn pass_through<T>(value: T) -> T {
    when { return delta_value(value) }
}
fn forward_list(value: list<i64>) -> list<i64> => pass_through(value)

test growing_list_publications {
    assert eval(forward_list, value: [
        delta<list<i64>>(items: [0: 1, 1: 2]),
        delta<list<i64>>(items: [1: 3, 2: 4]),
        _,
        delta<list<i64>>(items: [0: 5], remove: [1, 2]),
        delta<list<i64>>(remove: [0]),
        delta<list<i64>>(items: [0: 6])
    ]) == [
        delta<list<i64>>(items: [0: 1, 1: 2]),
        delta<list<i64>>(items: [1: 3, 2: 4]),
        _,
        delta<list<i64>>(items: [0: 5], remove: [2, 1]),
        delta<list<i64>>(remove: [0]),
        delta<list<i64>>(items: [0: 6])
    ]
    assert eval(forward_list, value: [_, _]) == [_, _]
    assert eval(forward_list, value: []) == []
}

# Provisional first-slice syntax: a helper, an export, and a helper test.

module examples.prices

use hgraph.analytics::{rolling_mean}

fn midpoint(
    tob: atomic<tuple<f64, f64>>
) -> f64 =>
    (tob[0] + tob[1]) / 2.0

export fn smooth(
    tob: atomic<tuple<f64, f64>>,
    const window: i64 = 20
) -> f64 {
    rolling_mean(midpoint(tob), window)
}

fn top_of_book(bid: f64, ask: f64) -> atomic<tuple<f64, f64>> {
    when { return (bid, ask) }
}

fn midpoint_from_prices(bid: f64, ask: f64) -> f64 => midpoint(top_of_book(bid, ask))

test midpoint_ticks {
    # Construct the atomic value inside the graph; eval uses scalar boundaries.
    assert eval(midpoint_from_prices, bid: [1.0, _, 2.0], ask: [2.0, _, 3.0]) == [1.5, _, 2.5]
}

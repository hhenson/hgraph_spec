module examples.mutable_values

struct Box {
    amount: i64
}

struct Envelope {
    inner: Box
}

const fn change_owned_contents() -> i64 {
    var box: Box = Box(amount: 1)
    box.amount = 2
    return box.amount
}

const fn replace_owned_value() -> i64 {
    var box: Box = Box(amount: 1)
    box = Box(amount: 3)
    return box.amount
}

const fn copy_readonly_value() -> i64 {
    let source: Box = Box(amount: 4)
    var independent = source
    independent.amount = 9
    return source.amount
}

const fn copy_owned_binding() -> i64 {
    var source: Box = Box(amount: 5)
    let independent = source
    source.amount = 8
    return independent.amount
}

const fn retain_constructor_argument() -> i64 {
    var source: Box = Box(amount: 6)
    let retained: Envelope = Envelope(inner: source)
    source.amount = 9
    return retained.inner.amount
}

const fn mutate_owned_child() -> bool {
    let child: Box = Box(amount: 7)
    let outer: Envelope = Envelope(inner: child)
    var independent = outer
    independent.inner.amount = 10
    return independent.inner.amount == 10 && outer.inner.amount == 7 && child.amount == 7
}

test ordinary_value_mutability {
    assert change_owned_contents() == 2
    assert replace_owned_value() == 3
    assert copy_readonly_value() == 4
    assert copy_owned_binding() == 5
    assert retain_constructor_argument() == 6
    assert mutate_owned_child()
}

# The importing side of the pair with market-data.hgl (ADR 0013).
#
# The imported type IS the exporting module's type: there is no copy under
# this module's namespace, so a value built here crosses back to
# examples.market_data without conversion and both modules see one schema.
# Generated C++ refers to that module's own definition and includes its
# header rather than re-declaring the struct.
#
# Checking this module needs the exporter's descriptor:
#     hgl test instrument-book.hgl --module-descriptor market-data.hgl-module.json

module examples.instrument_book

use examples.market_data as market
use examples.market_data::{Quote}

# Extending a family the library publishes -- the reason to publish one.
export struct Future: market::Instrument {
    expiry: i64
}

# `symbol` is inherited from the imported parent; `expiry` is declared here.
export fn future_symbol(future: atomic<Future>) -> str => future.symbol
export fn future_expiry(future: atomic<Future>) -> i64 => future.expiry

# Constructing the imported struct, in either spelling. Both name one type.
export fn flat(price: f64) -> atomic<Quote> => Quote(bid: price, ask: price)
export fn widened(price: f64) -> atomic<market::Quote> =>
    market::Quote(bid: price - 0.5, ask: price + 0.5)

export fn spread(quote: atomic<Quote>) -> f64 => quote.ask - quote.bid

# The imported recursive struct rebuilds its edge here (ADR 0012).
export fn next_tenor(leg: atomic<market::Leg>) -> str => leg.next.tenor

# Keep atomic and recursive values inside the graph: eval's current
# publication profile does not replay or record those shapes.
fn make_future(symbol: str, expiry: i64) -> atomic<Future> =>
    Future(symbol: symbol, expiry: expiry)
fn constructed_future_symbol(symbol: str, expiry: i64) -> str =>
    future_symbol(make_future(symbol, expiry))
fn constructed_future_expiry(symbol: str, expiry: i64) -> i64 =>
    future_expiry(make_future(symbol, expiry))

fn quote_mid(quote: atomic<Quote>) -> f64 => (quote.bid + quote.ask) / 2.0
fn flat_mid(price: f64) -> f64 => quote_mid(flat(price))
fn flat_spread(price: f64) -> f64 => spread(flat(price))
fn widened_mid(price: f64) -> f64 => quote_mid(widened(price))
fn widened_spread(price: f64) -> f64 => spread(widened(price))

fn make_leg(tenor: str, following_tenor: str) -> atomic<market::Leg> =>
    market::Leg(tenor: tenor, next: market::Leg(tenor: following_tenor))
fn constructed_next_tenor(tenor: str, following_tenor: str) -> str =>
    next_tenor(make_leg(tenor, following_tenor))

test a_local_child_carries_the_inherited_field {
    assert eval(constructed_future_symbol, symbol: ["ESZ5"], expiry: [3]) == ["ESZ5"]
    assert eval(constructed_future_expiry, symbol: ["ESZ5"], expiry: [3]) == [3]
}

test an_imported_struct_is_constructed_and_read_back {
    assert eval(flat_mid, price: [10.0]) == [10.0]
    assert eval(flat_spread, price: [10.0]) == [0.0]
}

test either_spelling_names_one_type {
    assert eval(widened_mid, price: [10.0]) == [10.0]
    assert eval(widened_spread, price: [10.0]) == [1.0]
}

test an_imported_recursive_struct_keeps_its_edge {
    assert eval(constructed_next_tenor, tenor: ["1Y"], following_tenor: ["2Y"]) == ["2Y"]
}

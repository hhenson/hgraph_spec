module examples.structural_value_publication

struct Pair {
    left: i64
    right: bool
}

fn select_value(step: i64, a: Pair, b: Pair) -> Pair {
    when modified(step) && valid(step) && valid(a) && valid(b) {
        if step == 1 { let copy = a; return copy }
        else { let copy = b; return copy }
    }
}

fn select_delta(step: i64, a: Pair, b: Pair) -> Pair {
    when modified(step) && valid(step) && valid(a) && valid(b) {
        if step == 1 {
            if modified(a) { return delta_value(a) }
        } else {
            if modified(b) { return delta_value(b) }
        }
    }
}

fn pair_validity(step: i64, watched: Pair) -> bool {
    when modified(step) && valid(step) { return all_valid(watched) }
}
fn value_validity(step: i64, a: Pair, b: Pair) -> bool =>
    pair_validity(step, select_value(step, a, b))
fn delta_validity(step: i64, a: Pair, b: Pair) -> bool =>
    pair_validity(step, select_delta(step, a, b))

test complete_value_and_delta_have_distinct_child_validity {
    let full = delta<Pair>(left: 1, right: true)
    let partial = delta<Pair>(left: 2)
    # B is independently partial; it never held A's right-hand value.
    assert eval(value_validity, step: [1, 2, 3], a: [full, _, _], b: [partial, partial, _]) == [true, false, false]
    assert eval(delta_validity, step: [1, 2, 3], a: [full, _, _], b: [partial, partial, _]) == [true, true, true]
}

fn removing_map(step: i64) -> map<i64, i64> {
    inject out
    when {
        if step == 1 { upsert(out, 7, 10); upsert(out, 8, 20) }
        else if step == 2 { remove(out, 8) }
    }
}
fn invalidating_map(step: i64) -> map<i64, i64> {
    inject out
    when {
        if step == 1 { upsert(out, 7, 10); upsert(out, 8, 20) }
        else if step == 2 { invalidate(out, 8) }
    }
}
fn copy_map(step: i64, value: map<i64, i64>) -> map<i64, i64> {
    when modified(step) && valid(step) && valid(value) { let copy = value; return copy }
}
fn delta_map(value: map<i64, i64>) -> map<i64, i64> {
    when { return delta_value(value) }
}
fn has_second(step: i64, watched: map<i64, i64>) -> bool {
    when modified(step) && valid(step) && valid(watched) { return contains(watched, 8) }
}
fn map_validity(step: i64, watched: map<i64, i64>) -> bool {
    when modified(step) && valid(step) { return all_valid(watched) }
}
fn copied_membership(step: i64) -> bool => has_second(step, copy_map(step, removing_map(step)))
fn delta_membership(step: i64) -> bool => has_second(step, delta_map(removing_map(step)))
fn copied_invalid_membership(step: i64) -> bool => has_second(step, copy_map(step, invalidating_map(step)))
fn copied_map_validity(step: i64) -> bool => map_validity(step, copy_map(step, invalidating_map(step)))

# Child invalidation is observed through the complete value; no empty delta
# application or new invalid member is required by these cases.
test complete_map_copy_reconciles_membership_and_child_validity {
    assert eval(copied_membership, step: [1, 2, 3]) == [true, false, false]
    assert eval(delta_membership, step: [1, 2, 3]) == [true, false, false]
    assert eval(copied_invalid_membership, step: [1, 2, 3]) == [true, true, true]
    assert eval(copied_map_validity, step: [1, 2, 3]) == [true, false, false]
}
